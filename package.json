{
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.5",
  "scripts": {
    "preinstall": "npx only-allow bun",
    "dev": "bun run db:migrate:local && vite dev",
    "build": "wrangler types --check --include-main-module=false && vite build && bun scripts/wrap-worker.ts",
    "preview": "wrangler dev --port 4173",
    "deploy": "just smoke && bun run db:migrate && wrangler deploy",
    "prepare": "panda codegen && svelte-kit sync || echo ''",
    "gen": "wrangler types --include-main-module=false",
    "check": "wrangler types --check --include-main-module=false && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "codegen": "panda codegen",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply xevion-dev --remote",
    "db:migrate:local": "wrangler d1 migrations apply xevion-dev --local",
    "db:studio": "drizzle-kit studio",
    "cli": "bun cli/main.ts",
    "cli:build": "bun build --compile --minify cli/main.ts --outfile dist/xevion"
  },
  "dependencies": {
    "@cf-wasm/resvg": "^0.4.0",
    "@cf-wasm/satori": "^0.4.2",
    "@floating-ui/dom": "^1.7.6",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/schibsted-grotesk": "^5.2.8",
    "@fontsource/geist-mono": "^5.2.8",
    "@fontsource/hanken-grotesk": "^5.2.8",
    "@fontsource/schibsted-grotesk": "^5.2.8",
    "@logtape/logtape": "^2.0.0",
    "@tiptap/core": "^3.26.0",
    "@tiptap/extension-code": "^3.26.0",
    "@tiptap/extension-code-block-lowlight": "^3.26.0",
    "@tiptap/extension-drag-handle": "^3.26.1",
    "@tiptap/extension-unique-id": "^3.26.1",
    "@tiptap/markdown": "^3.35.0",
    "@tiptap/pm": "^3.26.0",
    "@tiptap/starter-kit": "^3.26.0",
    "@tiptap/static-renderer": "^3.26.0",
    "@tiptap/suggestion": "^3.26.1",
    "@xevion/satori-html": "^0.4.1",
    "arktype": "^2.2.10",
    "blurhash": "^2.0.5",
    "drizzle-orm": "^0.45.4",
    "github-slugger": "^2.0.0",
    "lowlight": "^3.3.0",
    "nanoid": "^5.1.11",
    "neverthrow": "^8.2.0",
    "overlayscrollbars": "^2.13.0",
    "overlayscrollbars-svelte": "^0.5.5",
    "posthog-js": "^1.323.0",
    "sanitize-html": "^2.17.4",
    "seedrandom": "^3.0.5",
    "shiki": "^4.2.0",
    "svelte-dnd-action": "^0.9.69",
    "svelte-sonner": "^1.1.1",
    "svelte-tiptap": "^3.0.1",
    "sveltekit-superforms": "^3.1.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.9.2",
    "@eslint/js": "^9.39.2",
    "@fontsource/inter": "^5.2.8",
    "@iconify/json": "^2.2.561",
    "@pandacss/dev": "^1.8.2",
    "@sveltejs/adapter-cloudflare": "^9.0.0",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "@types/bun": "^1.4.5",
    "@types/node": "^25.0.9",
    "@types/sanitize-html": "^2.16.1",
    "@types/seedrandom": "^3.0.8",
    "ansis": "^4.5.0",
    "cleye": "^2.7.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.14.0",
    "globals": "^17.0.0",
    "prettier": "^3.8.0",
    "prettier-plugin-svelte": "^3.4.1",
    "smol-toml": "^1.9.1",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "typescript": "^6",
    "typescript-eslint": "^8.53.0",
    "unplugin-icons": "^23.0.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.168.0"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "name": "xevion-dev"
}
